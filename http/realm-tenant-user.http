### Create a new realm
POST http://localhost:8180/realms
Content-Type: application/json
Accept: application/json

{
  "name": "Test Realm3",
  "slug": "test-realm3"
}

### Create new realm tenant
POST http://localhost:8180/realms/test-realm2/tenants
Content-Type: application/json
Accept: application/json

{
  "name": "Test Tenant3",
  "slug": "test-tenant3",
  "enabled": true
}

### Create tenant user
POST http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts
Content-Type: application/json
Accept: application/json

{
  "enabled": true,
  "username": "+17015550104",
  "phone": "+17015550104",
  "email": null,
  "firstName": "Testy3",
  "lastName": "Testerson3",
  "attributes": {
    "custom": "hello world"
  }
}

> {%
    client.global.set("id", response.body.id)
%}


### Update tenant user
PATCH http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts/{{id}}
Content-Type: application/json
Accept: application/json

{
  "enabled": true,
  "username": "+17015550105",
  "phone": "+17015550105",
  "email": "test5@test.com",
  "firstName": "Testy",
  "lastName": "Testerson",
  "attributes": {
    "custom": "hello world"
  }
}

### Get tenant user
GET http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts/{{id}}
Accept: application/json

### Delete tenant user
DELETE http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts/{{id}}