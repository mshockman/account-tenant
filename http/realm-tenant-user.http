### Create a new realm
POST http://localhost:8180/realms
Content-Type: application/json
Accept: application/json

{
  "name": "Test Realm6",
  "slug": "test-realm6"
}

### Create new realm tenant
POST http://localhost:8180/realms/test-realm6/tenants
Content-Type: application/json
Accept: application/json

{
  "name": "Test Tenant6",
  "slug": "test-tenant6",
  "enabled": true
}

### Create tenant user
POST http://localhost:8180/realms/test-realm6/tenants/test-tenant6/accounts
Content-Type: application/json
Accept: application/json

{
  "enabled": true,
  "username": "+17015550201",
  "phone": "+17015550201",
  "email": null,
  "firstName": "Testy51",
  "lastName": "Testerson51",
  "attributes": {
    "custom": "hello world"
  }
}

> {%
    client.global.set("id", response.body.id)
%}


### Update tenant user
PATCH http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts/{{id}}
Content-Type: application/json
Accept: application/json

{
  "enabled": true,
  "username": "+17015550105",
  "phone": "+17015550105",
  "email": "test5@test.com",
  "firstName": "Testy",
  "lastName": "Testerson",
  "attributes": {
    "custom": "hello world"
  }
}

### Get tenant user
GET http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts/{{id}}
Accept: application/json

### Delete tenant user
DELETE http://localhost:8180/realms/test-realm2/tenants/test-tenant2/accounts/{{id}}