<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.32.xsd">
    <changeSet id="8" author="Matthew Shockman">

        <createTable tableName="account_identity_link">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" unique="true" />
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="uuid">
                <constraints nullable="false" />
            </column>
            <column name="identity_id" type="uuid">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="account_identity_link"
                baseColumnNames="account_id"
                constraintName="fk_account_identity_link_account"
                referencedTableName="account"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

        <addForeignKeyConstraint
                baseTableName="account_identity_link"
                baseColumnNames="identity_id"
                constraintName="fk_account_identity_link_identity"
                referencedTableName="identity"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

        <addUniqueConstraint
                tableName="account_identity_link"
                columnNames="account_id, identity_id"
                constraintName="uq_account_identity_link_account_identity"
        />

        <sql>
            CREATE TRIGGER updated_at_now BEFORE UPDATE ON "account_identity_link" FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
        </sql>

        <rollback>
            <dropForeignKeyConstraint baseTableName="account_identity_link" constraintName="fk_account_identity_link_identity" />
            <dropForeignKeyConstraint baseTableName="account_identity_link" constraintName="fk_account_identity_link_account" />
            <dropUniqueConstraint tableName="uq_account_identity_link_account_identity" />
            <dropTable tableName="account_identity_link" />
        </rollback>
    </changeSet>
</databaseChangeLog>