<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.32.xsd">
    <changeSet id="6" author="Matthew Shockman">
        <createTable tableName="identity">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false" unique="true" />
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false" />
            </column>
            <column name="identity_provider_id" type="uuid">
                <constraints nullable="false" />
            </column>
            <column name="subject" type="text">
                <constraints nullable="false" />
            </column>
            <column name="enabled" type="bool" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
        </createTable>

        <sql>
            CREATE TRIGGER updated_at_now BEFORE UPDATE ON "identity" FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
        </sql>

        <addForeignKeyConstraint
                baseTableName="identity"
                baseColumnNames="identity_provider_id"
                constraintName="fk_identity_identity_provider"
                referencedTableName="identity_provider"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

        <addUniqueConstraint tableName="identity" columnNames="identity_provider_id, subject" constraintName="uq_idp_subject" />

        <rollback>
            <dropForeignKeyConstraint baseTableName="identity" constraintName="fk_identity_identity_provider" />
            <dropUniqueConstraint tableName="identity" constraintName="uq_idp_subject" />
            <dropTable tableName="identity" />
        </rollback>
    </changeSet>
</databaseChangeLog>